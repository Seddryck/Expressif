{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Expressif",
  "scopeName": "source.expressif",
  "fileTypes": ["expressif", "expr"],
  "patterns": [
    {
      "begin": "(\\()(?=\\s*[A-Za-z][A-Za-z0-9]*(?:\\s*,\\s*[A-Za-z][A-Za-z0-9]*)+\\s*\\)\\s*:>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.binding.begin.expressif" }
      },
      "end": "(:>)",
      "endCaptures": {
        "1": { "name": "keyword.operator.expressif" }
      },
      "patterns": [
        {
          "name": "variable.other.definition.expressif",
          "match": "[A-Za-z][A-Za-z0-9]*"
        },
        {
          "name": "punctuation.separator.binding.expressif",
          "match": "[,)]"
        }
      ]
    },
    {
      "match": "(?<![\\w-])([A-Za-z][A-Za-z0-9]*)(\\s*)(:>)",
      "captures": {
        "1": { "name": "variable.other.definition.expressif" },
        "3": { "name": "keyword.operator.expressif" }
      }
    },
    {
      "name": "variable.other.expressif",
      "match": "@(?:_|[A-Za-z][A-Za-z0-9]*)"
    },
{{~ for function in model.functions ~}}
    {
      "name": "support.function.expressif.{{ function.scope | string.downcase }}",
      "match": "(?<![\\w-]){{ function.regex }}(?![\\w-])"
    }{{ if !for.last }},{{ end ~}}
{{~ end ~}}
{{~ if model.functions.size > 0 ~}},{{~ end ~}}
{{~ for predicate in model.predicates ~}}
    {
      "name": "support.function.expressif.predicate.{{ predicate.scope | string.downcase }}",
      "match": "(?<![\\w-]){{ predicate.regex }}(?![\\w-])"
    }{{ if !for.last }},{{ end ~}}
{{~ end ~}}
{{~ if model.predicates.size > 0 ~}},{{~ end ~}}
{{~ for accumulator in model.accumulators ~}}
    {
      "name": "support.function.expressif.accumulator.{{ accumulator.scope | string.downcase }}",
      "match": "(?<![\\w-]){{ accumulator.regex }}(?![\\w-])"
    }{{ if !for.last }},{{ end ~}}
{{~ end ~}}
{{~ if model.accumulators.size > 0 ~}},{{~ end ~}}
    {
        "name": "constant.language.expressif",
        "match": "({{ model.constantRegex }})\\b"
    },
    {
        "name": "storage.type.expressif",
        "match": "(?:{{ model.typeRegex }})\\b"
    },
    {
        "name": "constant.numeric.expressif",
        "match": "\\b[+-]?\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "string.quoted.double.expressif",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
           "name": "constant.character.escape.expressif",
           "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.backtick.expressif",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.expressif",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.operator.expressif",
      "match": "{{ model.operatorRegex }}"
    }
  ]
}
