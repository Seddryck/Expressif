<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>..\artifacts\branding\expressif-dark.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>expressif</ToolCommandName>
    <PackageId>Expressif-cli</PackageId>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-musl-x64</RuntimeIdentifiers>
    <!-- The .NET 10.0.400 SDK adds identical pointer settings once per TFM. -->
    <!-- Package validation confirms that NuGet retains one valid copy. -->
    <NoWarn>$(NoWarn);NU5118</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PocketCsvReader" Version="2.36.34" />
    <PackageReference Include="System.CommandLine" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Expressif\Expressif.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Expressif.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="GenerateApplicationIcon"
          BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectDirectory)\..\Build-Logo.ps1;$(MSBuildProjectDirectory)\..\assets\logo\layers\circle.png;$(MSBuildProjectDirectory)\..\assets\logo\layers\cup.png;$(MSBuildProjectDirectory)\..\assets\logo\layers\liquid.png;$(MSBuildProjectDirectory)\..\assets\logo\layers\steam.png;$(MSBuildProjectDirectory)\..\assets\logo\text.png"
          Outputs="$(MSBuildProjectDirectory)\..\artifacts\branding\expressif-dark.ico">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\Build-Logo.ps1&quot;" />
  </Target>

</Project>
