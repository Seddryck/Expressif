# syntax=docker/dockerfile:1

FROM alpine:3.23 AS downloader

RUN apk add --no-cache curl jq tar

WORKDIR /download

RUN ASSET_URL="$(curl -fsSL \
      https://api.github.com/repos/Seddryck/Expressif/releases/latest \
      | jq -r '.assets[] | select(.name | endswith("-net10.0-{{ model.assetSuffix }}")) | .browser_download_url' \
      | head -n 1)" \
    && test -n "$ASSET_URL" \
    && test "$ASSET_URL" != "null" \
    && curl -fsSL "$ASSET_URL" -o expressif.tar.gz \
    && mkdir app \
    && tar -xzf expressif.tar.gz -C app \
    && chmod +x app/expressif

FROM {{ model.runtimeImage }}

WORKDIR /app

COPY --from=downloader /download/app/ ./

ENTRYPOINT ["/app/expressif"]